{
  "manifest_version": 3,
  "name": "AI Chat Assistant",
  "description": "Multi-provider AI chat extension with page context support for Ollama and OpenRouter",
  "version": "2.2.0",
  "action": {
    "default_title": "AI Chat Assistant"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": [
    "declarativeNetRequest",
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "contextMenus"
  ],
  "host_permissions": [
    "http://*:11434/*",
    "https://*:11434/*",
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/page-extractor.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
